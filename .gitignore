# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp

# Claude Code local settings
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Skill iteration workspaces (scratch: fixtures, eval runs)
*-workspace/

# Logs & temp
*.log
tmp/
.tmp/

# Python bytecode (bundled scripts)
__pycache__/
*.pyc

# Skill eval suites (dev-only, not distributed)
skills/*/evals/
# ux-ui-principles keeps its eval suite (scenarios, fixtures, scripts) under version control; run output stays local
!skills/ux-ui-principles/evals/
skills/ux-ui-principles/evals/results/

# Generated preview images (rebuild with skills/ux-ui-principles/scripts/build_previews.js)
skills/*/assets/*/previews/

# Node dependencies (playwright dev-dep for render/preview scripts)
node_modules/

# Design-inspector output (screenshots, report.json)
.taste-skill/

# Open Design showcase study pictures (rights cover the plugin, not every depicted asset); rebuild with scripts/showcase_fetch.py
skills/*/assets/showcase/img/
skills/*/assets/showcase/items.json

# Mobbin app-screen study pictures (other companies' products, captured by Mobbin) and their signed URLs; rebuild with scripts/mobbin_fetch.py
skills/*/assets/mobbin/img/
skills/*/assets/mobbin/urls.json

# Market study screenshots of real businesses' sites (their copyright); rebuild with scripts/market_fetch.js
skills/*/assets/market/img/
